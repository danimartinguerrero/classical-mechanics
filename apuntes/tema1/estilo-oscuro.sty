\definecolor{caja}{HTML}{0E1014}
\definecolor{texto}{HTML}{ECECEC}
\definecolor{tenue}{HTML}{9CA0A8}
\definecolor{regla}{HTML}{2E3036}
\definecolor{rejilla}{HTML}{1C1F24}
\definecolor{cian}{HTML}{20B4CE}
\definecolor{violeta}{HTML}{A48BFA}
\definecolor{rosa}{HTML}{F472B6}
\definecolor{ambar}{HTML}{FBBF24}
\definecolor{verde}{HTML}{4ADE80}
