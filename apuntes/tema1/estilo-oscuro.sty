\fancyhead[RO]{\small\color{tenue}\thepage}
\fancyhead[LO]{\small\color{tenue}\textsc{\cabeceraimpar}}
\fancyhead[LE]{\small\color{tenue}\thepage}
\fancyhead[RE]{\small\color{tenue}\textsc{\cabecerapar}}
\renewcommand{\headrule}{{\color{regla}\hrule height 0.4pt\vspace{-0.4pt}}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrule}{}%
