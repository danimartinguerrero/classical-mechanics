% ---------------------------------------------------------------------
%  Matemáticas
% ---------------------------------------------------------------------
\RequirePackage{amsmath,amssymb,mathtools,amsthm}
\RequirePackage{bm}
\RequirePackage{esint}                 % \oint, \oiint
\numberwithin{equation}{section}

% vectores y operadores
\newcommand{\vb}[1]{\bm{#1}}                          % vector
\newcommand{\uv}[1]{\hat{\bm{#1}}}                    % vector unitario
\newcommand{\ii}{\uv{\imath}}                         % î
\newcommand{\jj}{\uv{\jmath}}                         % ĵ
\newcommand{\kk}{\uv{k}}                              % k̂
\newcommand{\er}{\uv{e}_{r}}
\newcommand{\et}{\uv{e}_{\theta}}
\newcommand{\ef}{\uv{e}_{\varphi}}
\newcommand{\erho}{\uv{e}_{\rho}}
\newcommand{\utau}{\hat{\bm{\tau}}}
% derivada temporal de un vector unitario con subíndice: \duv{e}{\rho} -> ê̇_ρ
\newcommand{\duv}[2]{\dot{\hat{\bm{#1}}}_{#2}}
\newcommand{\un}{\uv{n}}
\newcommand{\ub}{\uv{b}}
\newcommand{\tors}{\mathcal{T}}                       % torsión
\newcommand{\dd}{\mathop{}\!\mathrm{d}}
\newcommand{\pd}[2]{\frac{\partial #1}{\partial #2}}
\newcommand{\od}[2]{\frac{\dd #1}{\dd #2}}
\newcommand{\nablab}{\bm{\nabla}}
\newcommand{\grad}{\nablab}
\renewcommand{\div}{\nablab\cdot}
\newcommand{\rot}{\nablab\times}
\newcommand{\lap}{\nabla^{2}}
\newcommand{\abs}[1]{\left\lvert #1\right\rvert}
\newcommand{\norm}[1]{\left\lVert #1\right\rVert}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathcal{C}}
\newcommand{\defeq}{\stackrel{\text{def}}{=}}
\newcommand{\e}{\mathrm{e}}

% ---------------------------------------------------------------------
%  Títulos de sección
% ---------------------------------------------------------------------
\RequirePackage{titlesec}
\RequirePackage{needspace}
\titleformat{\section}
  {\needspace{9\baselineskip}\normalfont\Large\bfseries}
  {\textcolor{cian}{\thesection}}{0.9em}{}
  [\vspace{0.6ex}{\color{regla}\titlerule[0.6pt]}]
\titlespacing*{\section}{0pt}{5.2ex plus 1ex minus .4ex}{2.6ex}
\titleformat{\subsection}
  {\needspace{6\baselineskip}\normalfont\large\bfseries}
  {\textcolor{cian}{\thesubsection}}{0.8em}{}
\titlespacing*{\subsection}{0pt}{3.6ex plus .8ex minus .3ex}{1.6ex}
\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries}
  {\textcolor{cian}{\thesubsubsection}}{0.7em}{}

