}

% ---------------------------------------------------------------------
%  Enlaces y referencias cruzadas
% ---------------------------------------------------------------------
\RequirePackage{aliascnt}
\RequirePackage[hidelinks,bookmarksnumbered,pdfencoding=auto]{hyperref}
\hypersetup{colorlinks=true,linkcolor=cian,citecolor=ambar,urlcolor=cian}
\RequirePackage[spanish,noabbrev]{cleveref}
\crefname{table}{tabla}{tablas}\Crefname{table}{Tabla}{Tablas}
\crefname{figure}{figura}{figuras}\Crefname{figure}{Figura}{Figuras}
\crefname{section}{sección}{secciones}\crefname{subsection}{apartado}{apartados}

% ---------------------------------------------------------------------
%  Entornos tipo teorema (tcolorbox)
% ---------------------------------------------------------------------
\RequirePackage[most]{tcolorbox}
\newcounter{thm}[section]
\renewcommand{\thethm}{\thesection.\arabic{thm}}

\tcbset{
  base/.style={enhanced,breakable,colback=caja,coltext=texto,
    boxrule=0.6pt,arc=2pt,outer arc=2pt,
    left=9pt,right=9pt,top=10pt,bottom=7pt,
    before skip=3.2ex plus 1ex,after skip=2.6ex plus 1ex,
    attach boxed title to top left={xshift=6pt,yshift*=-\tcboxedtitleheight/2},
    boxed title style={boxrule=0pt,arc=2pt,left=4pt,right=4pt,top=1.5pt,bottom=1.5pt},
    fonttitle=\sffamily\bfseries\small},
  definicion/.style={base,colframe=cian,
    boxed title style={colback=cian},coltitle=black},
  teorema/.style={base,colframe=violeta,
    boxed title style={colback=violeta},coltitle=black,fontupper=\itshape},
  problema/.style={base,colframe=cian!55!regla,
    boxed title style={colback=caja,colframe=cian,boxrule=0.6pt},coltitle=cian},
}

% \declararcaja{entorno}{Nombre}{estilo}{nombre-cref}{plural-cref}
\newcommand{\declararcaja}[5]{%
  \newaliascnt{#1}{thm}%
  \crefname{#1}{#4}{#5}\Crefname{#1}{\MakeUppercase #4}{\MakeUppercase #5}%
  \NewDocumentEnvironment{#1}{o}{%
    \refstepcounter{#1}%
    \begin{tcolorbox}[#3,title={#2~\thethm\IfValueT{##1}{\ \mdseries(##1)}}]}%
    {\end{tcolorbox}}}

\declararcaja{definicion}{Definición}{definicion}{definición}{definiciones}
\declararcaja{teorema}{Teorema}{teorema}{teorema}{teoremas}
\declararcaja{proposicion}{Proposición}{teorema}{proposición}{proposiciones}
\declararcaja{lema}{Lema}{teorema}{lema}{lemas}
\declararcaja{corolario}{Corolario}{teorema}{corolario}{corolarios}

% entornos «en línea» (sin caja), numerados con el mismo contador
% \declararlinea{entorno}{Nombre}{formato del nombre}{cref}{plural}
\newcommand{\declararlinea}[5]{%
  \newaliascnt{#1}{thm}%
  \crefname{#1}{#4}{#5}%
  \NewDocumentEnvironment{#1}{o}{%
    \par\addvspace{1.6ex}\refstepcounter{#1}%
    \noindent{#3{#2~\thethm}}\IfValueT{##1}{\ {\color{tenue}(##1)}}.\enspace\ignorespaces}%
    {\par\addvspace{1.4ex}}}

\declararlinea{ejemplo}{Ejemplo}{\color{cian}\bfseries}{ejemplo}{ejemplos}
\declararlinea{observacion}{Observación}{\color{violeta}\bfseries\itshape}{observación}{observaciones}
\declararlinea{notacion}{Notación}{\color{cian}\bfseries}{notación}{notaciones}

% caja de idea clave / método: barra lateral
\NewDocumentEnvironment{clave}{O{cian}m}{%
  \begin{tcolorbox}[enhanced,breakable,colback=caja,coltext=texto,
    frame hidden,boxrule=0pt,arc=0pt,left=10pt,right=10pt,top=7pt,bottom=7pt,
    before skip=2.4ex,after skip=2.4ex,
    borderline west={2.2pt}{0pt}{#1}]
  {\sffamily\bfseries\small\color{#1}#2.}\enspace\ignorespaces}%
  {\end{tcolorbox}}

% enunciado de problema
\newcounter{problema}
\crefname{problema}{problema}{problemas}
% \begin{problema}{n.º de la hoja}[título]
\NewDocumentEnvironment{problema}{m o}{%
  \setcounter{problema}{#1}\addtocounter{problema}{-1}%
  \refstepcounter{problema}%
  \begin{tcolorbox}[problema,title={Problema~\theproblema\IfValueT{#2}{\ \mdseries(#2)}}]}%
  {\end{tcolorbox}}

% demostración y resolución
\renewcommand{\qedsymbol}{\textcolor{tenue}{\rule{0.62em}{0.62em}}}
\addto\captionsspanish{\renewcommand{\proofname}{\textcolor{texto}{\bfseries\itshape Demostración}}}
\NewDocumentEnvironment{resolucion}{}{%
  \begin{proof}[\textcolor{cian}{\bfseries\itshape Resolución}]}{\end{proof}}

% resultado enmarcado
\newcommand{\resultado}[1]{%
  {\setlength{\fboxsep}{5pt}\fcolorbox{tenue}{caja}{$\displaystyle #1$}}}

% etiqueta pequeña sobre llaves
\newcommand{\nota}[1]{\text{\scriptsize\color{tenue}#1}}

